#!/bin/bash
# rknpu-modelctl — EA3588S NPU 模型管理 CLI（06_MODEL_SERVICE 核心仲裁器）
# 设计依据：MODEL_SERVICE_DESIGN.md（互斥 flock / 哈希门 / CMA 预算 / G6 探针复用）
# 运行位：板端 root（/usr/local/sbin/rknpu-modelctl，部署随服务化批次审批）
# 纪律：不 rmmod / 不 reboot / volt/freq 禁读（白名单仅 version/load/power）
# 探针位：/opt/rknn-probe（首选，待部署）；回退 /tmp/g6（P8 期间兼容位）
# 用法：rknpu-modelctl verify | status | infer vision|llm

set -u
LOCK=/var/lock/rknpu-model.lock
PROBE_DIR_OPT=/opt/rknn-probe
PROBE_DIR_TMP=/tmp/g6
M1V_PROBE=g6_vision_probe
M1L_PROBE=g6_llm_probe
M1V_PROBE_SHA=bf3241138739f481ff699a909d37a096be1dc043a6451747c8b0f80fa832cf56
M1L_PROBE_SHA=6ebdb7cb2d56bf9a045f431c28681a160fd587f07b6db184210883b186fc12ce
M1V_MODEL=/home/admin/Downloads/qwen3-vl-2b_vision_rk3588.rknn
M1L_MODEL=/home/admin/Downloads/qwen3-vl-2b-instruct_w8a8_rk3588.rkllm
M1V_MODEL_SHA=3d707ef5dbf0e420ac48e57b5bf0ed6c0fd1d5d048c29d81e1b5a8d051ab7ea8
M1L_MODEL_SHA=d5474340221fc495c70e1ec2c7dafc4ebf88292ce466db7e771e3a20b99cf21f
M1V_CMA_NEED_KB=851968      # 832MiB + 余量（实测权重段 846,946,304B）
M1L_CMA_NEED_KB=1736704     # 1,696MiB + 余量（实测权重单块 1,720,451,072B）
LDPATH=/opt/rknn-runtime
PROMPT_LLM="用一句话介绍你自己。"

probe_dir() { [ -x "$PROBE_DIR_OPT/$M1V_PROBE" ] && echo "$PROBE_DIR_OPT" || echo "$PROBE_DIR_TMP"; }
cma_free() { grep "^CmaFree" /proc/meminfo | tr -dc 0-9; }
die() { echo "MODELCTL_FAIL: $*" >&2; exit 1; }

cmd_verify() {
  local OK=1
  [ -e /dev/dri/renderD128 ] || { echo "verify: renderD128 缺失"; OK=0; }
  grep -q "^rknpu" /proc/modules || { echo "verify: rknpu 未加载"; OK=0; }
  [ -r /sys/kernel/debug/rknpu/power ] || { echo "verify: debugfs power 不可读"; OK=0; }
  if [ -d "$LDPATH" ]; then
    echo "verify: 模型层已部署（$LDPATH）"
  else
    echo "verify: 注意 /opt/rknn-runtime 缺失——模型层未部署（恢复基线仅含驱动层；部署方法见 INSTALLATION_GUIDE）"
  fi
  echo "verify: module=$(grep "^rknpu" /proc/modules | awk '{print $1, $3, $4}') power=$(cat /sys/kernel/debug/rknpu/power 2>/dev/null) cmafree=$(cma_free)kB"
  [ $OK -eq 1 ] || die "verify 未通过"
  echo "MODELCTL_VERIFY_OK"
}

cmd_status() {
  echo "== NPU =="; cmd_verify || true
  echo "== 模型 =="
  echo "M1V 哈希: $(sha256sum "$M1V_MODEL" 2>/dev/null | cut -c1-16)（期望 3d707ef5dbf0e420） 预算 ${M1V_CMA_NEED_KB}kB"
  echo "M1L 哈希: $(sha256sum "$M1L_MODEL" 2>/dev/null | cut -c1-16)（期望 d5474340221fc495） 预算 ${M1L_CMA_NEED_KB}kB"
  local CF; CF=$(cma_free)
  echo "CmaFree: ${CF}kB（vision 可载: $([ "$CF" -ge "$M1V_CMA_NEED_KB" ] && echo yes || echo no)；llm 可载: $([ "$CF" -ge "$M1L_CMA_NEED_KB" ] && echo yes || echo no)）"
  echo "锁: $(exec 9>"$LOCK"; flock -n 9 && echo 空闲 || echo 占用中)"
}

run_infer() {  # $1=vision|llm
  local WHICH=${1:-}
  local PROBE DIR SHA NEED TMO MODEL RC
  case "$WHICH" in
    vision)
      PROBE=$M1V_PROBE; SHA=$M1V_PROBE_SHA; NEED=$M1V_CMA_NEED_KB; TMO=120
      MODEL=$M1V_MODEL ;;
    llm)
      PROBE=$M1L_PROBE; SHA=$M1L_PROBE_SHA; NEED=$M1L_CMA_NEED_KB; TMO=300
      MODEL=$M1L_MODEL ;;
    *) die "infer 须指定 vision|llm" ;;
  esac
  DIR=$(probe_dir)
  [ -x "$DIR/$PROBE" ] || die "探针缺失（$DIR/$PROBE；部署位 /opt/rknn-probe 待批）"
  [ "$(sha256sum "$DIR/$PROBE" 2>/dev/null | cut -d" " -f1)" = "$SHA" ] || die "探针哈希不符（防旧版误用）"
  [ -f "$MODEL" ] || die "模型文件缺失（$MODEL）"
  if [ "$WHICH" = "vision" ]; then
    [ "$(sha256sum "$MODEL" 2>/dev/null | cut -d" " -f1)" = "$M1V_MODEL_SHA" ] || die "M1V 模型哈希不符"
  else
    [ "$(sha256sum "$MODEL" 2>/dev/null | cut -d" " -f1)" = "$M1L_MODEL_SHA" ] || die "M1L 模型哈希不符"
  fi
  local CF; CF=$(cma_free)
  [ "$CF" -ge "$NEED" ] || die "CMA 不足（free=${CF}kB < need=${NEED}kB；另一模型可能占用——先完成/释放）"
  echo "infer $WHICH: budget ok（${CF}/${NEED}kB），探针+模型哈希 PASS，开始（timeout ${TMO}s）"
  if [ "$WHICH" = "vision" ]; then
    timeout "$TMO" "$DIR/$PROBE" "$MODEL" 1; RC=$?
  else
    timeout "$TMO" "$DIR/$PROBE" "$MODEL" "$PROMPT_LLM"; RC=$?
  fi
  [ $RC -eq 0 ] || die "推理失败/超时（rc=$RC，见上输出）"
  echo "infer $WHICH 完成（探针含 destroy，CMA 已释放）"
}

main() {
  local CMD=${1:-help}
  case "$CMD" in
    verify) cmd_verify ;;
    status) cmd_status ;;
    infer)
      shift
      exec 9>"$LOCK" || die "锁文件不可写（root 部署位 /var/lock）"
      flock -w 600 9 || die "全局锁等待超时（600s；另一模型推理中）"
      run_infer "$@" ;;
    help|*)
      echo "用法：rknpu-modelctl verify | status | infer vision|llm"
      echo "（互斥推理经 /var/lock/rknpu-model.lock 仲裁；vision/llm 不可并发）" ;;
  esac
}
main "$@"
